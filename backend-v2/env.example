# ============================================================================
# Water Tank Backend - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# cp env.example .env

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Optional. Defaults to 127.0.0.1 in production, so put Nginx in front.
# API_BIND_HOST=127.0.0.1

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# MySQL only. Add "?sslaccept=strict" (or your driver's TLS query param) to
# the URL if connecting to managed MySQL over TLS.
DATABASE_URL=mysql://user:password@localhost:3306/water_tank_db

# ----------------------------------------------------------------------------
# Firebase Admin SDK Configuration
# ----------------------------------------------------------------------------
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
# Single origin, or comma-separated list. In development, defaults to '*' if
# unset. In production, defaults to 'https://aquamind.utkarshjoshi.com' if unset.
CORS_ORIGIN=http://localhost:3001

# ----------------------------------------------------------------------------
# API Base URL
# ----------------------------------------------------------------------------
# Used to build absolute OTA firmware download URLs returned to devices.
API_BASE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# File Storage
# ----------------------------------------------------------------------------
# Path where firmware binaries are stored. Can be absolute or relative to the
# backend directory.
FIRMWARE_STORAGE_PATH=./storage/firmware

# ----------------------------------------------------------------------------
# Alert Configuration
# ----------------------------------------------------------------------------
# Minutes before a device is considered offline.
ALERT_OFFLINE_THRESHOLD_MINUTES=15

# ----------------------------------------------------------------------------
# Leak Detection Configuration
# ----------------------------------------------------------------------------
# Liters per hour threshold for leak detection. If consumption exceeds this
# rate (and no refill happened that day), a leak alert is triggered.
LEAK_DETECTION_THRESHOLD_L_PER_HOUR=50

# ----------------------------------------------------------------------------
# Admin Seed Configuration (Optional - for initial admin user setup)
# ----------------------------------------------------------------------------
# Run: npx prisma db seed
#
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=System Administrator
# ADMIN_PASSWORD=securePassword123
# ADMIN_FIREBASE_UID=existing-firebase-uid-here
# ADMIN_ROLE=super_admin
# ADMIN_TENANT_NAME=Default Tenant
#
# Note: Either ADMIN_PASSWORD (to create a new Firebase user) or
# ADMIN_FIREBASE_UID (to use an existing one) must be provided, not both.

# ----------------------------------------------------------------------------
# MQTT (Optional - Phase 2 device transport)
# ----------------------------------------------------------------------------
# If MQTT_URL is UNSET, MQTT is DISABLED and the backend runs HTTP-only (no
# broker needed for local dev/tests). When set, the MqttAdapter starts at boot,
# subscribes to devices/+/{telemetry,announce,ack}, and publishes retained
# config to devices/{id}/config. A down broker never crashes the server.
#
# MQTT_URL=mqtt://localhost:1883          # or mqtts://<host>:8883 (TLS, prod)
# MQTT_USERNAME=aquamind-backend          # backend's own static broker account
# MQTT_PASSWORD=change-me
# MQTT_TLS_CA_PATH=/path/to/ca.crt        # prod: CA bundle for a private broker CA
# MQTT_TLS_REJECT_UNAUTHORIZED=true       # default true; 'false' only for testing
# MQTT_AUTH_HOOK_SECRET=change-me         # shared secret for the /mqtt-auth hook (X-Broker-Auth)
