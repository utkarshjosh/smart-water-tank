# ============================================================================
# Root Level - Common Files
# ============================================================================

# Environment files
.env
.env.local
.env.*.local

# Secrets / credentials
*.secret
*service-account*.json
backend/firbase-service-account.json

# Arduino IDE local data
.arduino-data/

# IDE and Editor Files
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~

# Language Servers
.clangd/

# Arduino CLI (root level - should be in firmware/)
.arduino15/
.arduino15/**

# OS Files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.directory
.Trash-*

# Temporary and Log Files
*.log
*.tmp
*.temp
*.bak

# ============================================================================
# Firmware (Arduino/ESP8266)
# ============================================================================

# Build output
firmware/build/
firmware/build/**

# Compiled binaries
firmware/*.bin
firmware/*.elf
firmware/*.map
firmware/*.hex
firmware/*.eep

# Arduino CLI
firmware/.arduino15/
firmware/.arduino15/**

# Libraries (downloaded dependencies)
firmware/libraries/
firmware/libraries/**

# Arduino IDE
firmware/*.prefs

# Local config overrides
firmware/config.mk.local
firmware/*.local

# ============================================================================
# Backend (Node.js/TypeScript)
# ============================================================================

backend/node_modules/
backend/dist/
backend/.env
backend/*.log
backend/storage/
backend/.DS_Store

# ============================================================================
# Frontend (Vite/React)
# ============================================================================

frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env*.local

# ============================================================================
# Mobile App (React Native/Expo)
# ============================================================================

mobile-app/node_modules/
mobile-app/.expo/
mobile-app/.expo-shared/
mobile-app/dist/
mobile-app/web-build/
mobile-app/.env
mobile-app/*.jks
mobile-app/*.p8
mobile-app/*.p12
mobile-app/*.key
mobile-app/*.mobileprovision
mobile-app/*.orig.*
